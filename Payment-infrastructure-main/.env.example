# Copy to .env (or export these directly) before running `make dev`.
# None of these need to change for local development with the default `make setup`.

REDIS_ADDR=localhost:6379
POSTGRES_DSN=postgres://nazar:nazar@localhost:5432/nazar?sslmode=disable
PORT=8080

# Repo root, used to locate features/registry.yaml, rules/, policy/, py/training/output.
# Leave unset when running `go run ./cmd/nazar` from the go/ directory or via the Makefile —
# it auto-detects by walking up for features/registry.yaml. Set explicitly only if you move
# the compiled binary somewhere outside the repo.
# NAZAR_REPO_ROOT=/absolute/path/to/this/repo

# Container runtime the Resilience screen's "Kill/Restore Redis" buttons and demo Scenario E
# use to stop/start the Redis container. Defaults to "podman" for local dev; set to "docker"
# when deploying via docker-compose on a Docker host.
NAZAR_CONTAINER_ENGINE=podman

# Container name the chaos endpoint actually stop/starts via the engine above.
NAZAR_REDIS_CONTAINER=nazar-redis

# Consortium HMAC pepper for the current epoch (docs/05 §4.1). Demo-only value — rotate via
# a real secret in any non-demo deployment.
NAZAR_CONSORTIUM_PEPPER=demo-pepper-epoch-1-not-for-production
