# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# Comma-separated: the narrator rotates keys on auth / quota / rate-limit / 5xx failures.
# Omit entirely and the deterministic narrator takes over; nothing else changes.
NAZAR_LLM_API_KEYS=gsk_yourkey1,gsk_yourkey2
NAZAR_LLM_MODEL=openai/gpt-oss-120b
